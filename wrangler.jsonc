{
  "name": "your-ip-hn",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-12",
  "compatibility_flags": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "ip.hn.edu.kg",
      "custom_domain": true
    }
  ]
}
